# =====================================================================
# Application Environment Variables Template
# Copy this file to .env and configure your local or cloud values.
# NEVER commit your actual .env file or real secrets to GitHub!
# =====================================================================

# MongoDB Atlas or Local MongoDB Connection String
# Example format: mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/<database-name>?retryWrites=true&w=majority
# If left empty, the application automatically runs on its resilient in-memory store.
MONGODB_URI=

# Secret key used for signing and verifying JWT authentication tokens
# In production, set this to a cryptographically secure random string (e.g. openssl rand -base64 32)
JWT_SECRET=

# Designated administrator initial credentials (used on first-time bootstrap)
# If left unset, defaults to local dev credentials
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Allowed CORS Origin for production (e.g. https://your-service.onrender.com or custom domain)
# If left empty, allows current origin with credentials
CORS_ORIGIN=

# Node runtime environment ('development' or 'production')
NODE_ENV=production

# Server port (Render automatically provides PORT environment variable)
PORT=3000

# =====================================================================
# Platform User Limits, Quotas & Security Guardrails (Optional)
# Safe defaults are pre-configured; customize below if needed.
# Set MAX_USERS=0 to disable the global registration cap.
# =====================================================================
MAX_USERS=500
MAX_SUBJECTS_PER_USER=50
MAX_LECTURES_PER_SUBJECT=500
MAX_PROBLEMS_PER_USER=1000
MAX_EVENTS_PER_USER=1000
MAX_EVENTS_PER_DAY=50
MAX_NOTIFICATIONS_PER_USER=100
MAX_FEEDBACK_PER_USER=50
AUTH_RATE_LIMIT_MAX=20
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
IP_API_RATE_LIMIT_PER_MIN=600
USER_API_RATE_LIMIT_PER_MIN=240
