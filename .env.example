# =====================================================================
# Application Environment Variables Template
# Copy this file to .env and configure your local or cloud values.
# =====================================================================

# MongoDB Atlas or Local MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.zgnzcyt.mongodb.net/LMS?retryWrites=true&w=majority
# If left empty, the application automatically runs on its resilient in-memory store.
MONGODB_URI=

# Secret key used for signing and verifying JWT authentication tokens
JWT_SECRET=

# Designated administrator email address
# Users registering or logging in with this email automatically receive 'admin' privileges
ADMIN_EMAIL=

# Node runtime environment ('development' or 'production')
NODE_ENV=development

# Server port (Default: 3000)
PORT=3000
